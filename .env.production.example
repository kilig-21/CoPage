# 复制为 .env.production；密码建议分别生成 32 字节随机 hex，不复用本地开发值。
# 以下空值必须由部署负责人填写，未填写时 Compose 会拒绝运行。
PROD_MYSQL_ROOT_PASSWORD=
PROD_MYSQL_PASSWORD=
PROD_REDIS_PASSWORD=
PROD_RABBITMQ_PASSWORD=
PROD_MINIO_ROOT_USER=
PROD_MINIO_ROOT_PASSWORD=
PROD_JWT_SECRET=
PROD_FRONTEND_ORIGIN=
PROD_MINIO_PUBLIC_ENDPOINT=
# 仅绑定服务器回环地址，交给服务器上的 HTTPS 反向代理。
PROD_BACKEND_PORT=18080
PROD_MINIO_PORT=19000

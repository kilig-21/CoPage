# 复制为 .env.production；密码建议分别生成 32 字节随机 hex，不复用本地开发值。
# 以下空值必须由部署负责人填写，未填写时 Compose 会拒绝运行。
PROD_MYSQL_ROOT_PASSWORD=
PROD_MYSQL_PASSWORD=
PROD_REDIS_PASSWORD=
PROD_RABBITMQ_PASSWORD=
PROD_MINIO_ROOT_USER=
PROD_MINIO_ROOT_PASSWORD=
PROD_JWT_SECRET=
PROD_FRONTEND_ORIGIN=
PROD_MINIO_PUBLIC_ENDPOINT=
IMAGE_UPLOAD_COUNT_LIMIT=1000
IMAGE_UPLOAD_BYTE_LIMIT=268435456
# 仅绑定服务器回环地址，交给服务器上的 HTTPS 反向代理。
PROD_BACKEND_PORT=18080
PROD_MINIO_PORT=19000
# 普通历史自动清理。关闭时设为 false 并重启所有后端。
HISTORY_RETENTION_ENABLED=true
HISTORY_RETENTION_DAYS=30
HISTORY_MAX_OPERATIONS=10000
HISTORY_MAX_SNAPSHOTS=100
HISTORY_MAX_BYTES=67108864
HISTORY_PROTECTED_DOC_IDS=26,536,548
# ES 增量补偿巡检的间隔（毫秒）
SEARCH_REPAIR_INTERVAL_MS=5000
# 只填写与后端直连且覆盖 X-Forwarded-For 的 Nginx 对端地址，支持逗号分隔。
AUTH_LIMIT_TRUSTED_PROXIES=

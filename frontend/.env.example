# 本地开发留空，继续使用 Vite 的 /api、/ws 代理。
# Vercel 构建时分别填写公网后端的 HTTPS 与 WSS origin，不带 /api、/ws 路径。
VITE_BACKEND_HTTP_ORIGIN=
VITE_BACKEND_WS_ORIGIN=
# 开发默认关闭，生产构建默认开启；设为 false 可关闭。
# VITE_FRONTEND_ERROR_REPORTING_ENABLED=false
VITE_FRONTEND_ERROR_SAMPLE_RATE=0.2
# 非 Git 源码目录构建时可传入对应的完整提交 SHA。
# VITE_BUILD_SHA=
